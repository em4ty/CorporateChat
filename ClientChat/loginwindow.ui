  <property name="styleSheet">
   <string notr="true">/* Базовые цвета */
QWidget {
    background-color: #1a1a2e;
    color: #ffffff;
    font-family: 'Segoe UI', Arial, sans-serif;
}

/* Кнопки */
QPushButton {
    background-color: #9146ff;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #7a3cdb;
}
QPushButton:pressed {
    background-color: #5a2a8b;
}
QPushButton#logoutButton {
    background-color: #e94560;
}
QPushButton#logoutButton:hover {
    background-color: #c73a54;
}

/* Поля ввода */
QLineEdit {
    background-color: #16213e;
    border: 1px solid #9146ff;
    border-radius: 10px;
    padding: 10px;
    color: #ffffff;
}
QLineEdit:focus {
    border: 2px solid #b388ff;
}

/* Вкладки (для окна логина) */
QTabWidget::pane {
    border: 1px solid #9146ff;
    border-radius: 12px;
    background-color: #0f3460;
}
QTabBar::tab {
    background-color: #16213e;
    color: #aaaaaa;
    padding: 10px 20px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}
QTabBar::tab:selected {
    background-color: #9146ff;
    color: white;
}

/* Списки (контакты, чат) */
QListWidget {
    background-color: #16213e;
    border: 1px solid #9146ff;
    border-radius: 12px;
    padding: 5px;
}
QListWidget::item {
    padding: 8px;
    border-radius: 6px;
    color: #dddddd;
}
QListWidget::item:selected {
    background-color: #9146ff;
    color: white;
}
QListWidget::item:hover {
    background-color: #2a2a4a;
}

/* Метки (статус, заголовки) */
QLabel {
    color: #cccccc;
}
QLabel#statusLabel {
    color: #aaaaaa;
}</string>
